# 교과설계소 — 환경변수 예시 파일
#
# 이 파일은 실제 값을 담지 않습니다(전부 placeholder). 실제 운영 값은
# .env.local(gitignore 대상)에 직접 채워 넣으세요. secret 값은 이 파일에
# 절대 커밋하지 마세요.
#
# 현재 siteConfig(src/config/site.ts)에 하드코딩된 placeholder를 실제
# 운영 정보로 교체할 때, 아래 값들을 siteConfig가 읽어오도록 리팩터링하면
# 브랜드/도메인 정보를 코드 변경 없이 배포 환경별로 다르게 관리할 수 있습니다.
# (이번 작업에서는 siteConfig를 env 기반으로 바꾸지 않았습니다 — 실제 값이
# 없어 확인할 수 없고, 코드 구조 변경은 범위 밖입니다.)

# ── 사이트 기본 정보 (공개되어도 무방 — NEXT_PUBLIC_ 접두사) ──────────────
# 실제 배포 도메인. 현재 siteConfig.domain은 https://www.example-tutoring.com
NEXT_PUBLIC_SITE_DOMAIN=

# 대표 전화번호. 현재 siteConfig.phone/phoneDisplay에 실제 번호(010-2813-1821)가 직접 반영되어 있음
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=

# 카카오톡 채널 상담 URL. 현재 siteConfig.kakaoUrl은 ""(채널 없음 → 카카오 버튼 자동 숨김)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 문의 이메일. 현재 siteConfig.email은 contact@example-tutoring.com(placeholder)
NEXT_PUBLIC_CONTACT_EMAIL=

# 사업자 정보. 현재 siteConfig에는 비어 있음(businessName/
# businessRegistrationNumber/businessAddress) — footer 표시 조건부 렌더링이라
# 값이 없으면 그냥 해당 줄이 나타나지 않습니다.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ── 상담폼 저장소 (src/lib/consult/googleSheetsPersistence.ts) ──────────
# 구현됨: Google Apps Script Web App + Google Sheets. 상담 신청이 오면
# Next.js 서버가 아래 웹훅 URL로 1회 POST하고, Apps Script가 시트에 행을
# 추가한 뒤 같은 실행 안에서 관리자 이메일까지 보냅니다(Next.js가 별도로
# 이메일을 보내지 않음). Apps Script 코드와 설정 절차는
# docs/setup/consult-google-apps-script.md 참고.
#
# 값을 비워두면(=이 파일 그대로 두면) 상담 제출 시 사용자에게 "일시적인
# 오류가 발생했습니다" 안내가 나가고 실제로는 저장되지 않습니다 — 성공한
# 것처럼 조용히 실패하지 않도록 의도된 동작입니다. 실제 운영 전 반드시
# .env.local에 아래 세 값을 채워 넣으세요.

# Apps Script 배포 시 발급되는 Web App URL (https://script.google.com/macros/s/.../exec)
CONSULT_GOOGLE_SHEETS_WEBHOOK_URL=

# Next.js ↔ Apps Script 간 공유 secret. 아무 문자열이나 생성해 여기와
# Apps Script 스크립트 속성(WEBHOOK_SECRET)에 동일하게 넣으세요.
CONSULT_WEBHOOK_SECRET=

# 새 상담 신청 이메일을 받을 관리자 주소
CONSULT_ADMIN_EMAIL=

# "true"면 애매한 webhook 실패 시 같은 submissionId로 1회 자동 재시도.
# 반드시 Apps Script v2(docs/setup/consult-apps-script.gs)를 배포한 *뒤에* 켤 것
# — v1 스크립트에 재시도하면 중복 행/메일이 생김. 순서는
# docs/setup/consult-google-apps-script.md "v2로 업그레이드하는 순서" 참고.
CONSULT_WEBHOOK_IDEMPOTENT=

# ── 전환 측정 (src/lib/analytics.ts) ───────────────────────────────────
# GA4 측정 ID(G-XXXXXXXXXX). 비워 두면 GA 스크립트를 로드하지 않고 이벤트도 보내지 않음.
# 켜기 전에 /privacy에 Google Analytics(쿠키) 이용 고지를 추가할 것.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── 상담폼 알림 (src/lib/consult/notification.ts) ───────────────────────
# 현재는 위 Apps Script가 이메일 발송까지 함께 처리하므로 별도 채널은
# 사용하지 않습니다. Slack 등 두 번째 알림 채널이 필요해지면 여기에 추가하고
# notification.ts에 구현을 연결하세요.
# NOTIFICATION_WEBHOOK_URL=
